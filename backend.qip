set_global_assignment -name VERILOG_FILE src/soc/cdda.v

# The N-channel audio volume attenuator. It was the framework's `sb_volume`, extracted
# and renamed: the PC-9821 has no Sound Blaster, and only the name was ever SB.
set_global_assignment -name SYSTEMVERILOG_FILE src/pc9821/audio/pc9821_audio_volume.sv
# The 48 kHz output stage: the CIC decimator, the FIR MAC engine and the top that presents
# one sample per 512 CLK_AUDIO cycles.
set_global_assignment -name SYSTEMVERILOG_FILE src/pc9821/audio/pc9821_audio_cic4.sv
set_global_assignment -name SYSTEMVERILOG_FILE src/pc9821/audio/pc9821_audio_fir_engine.sv
set_global_assignment -name SYSTEMVERILOG_FILE src/pc9821/audio/pc9821_audio_out.sv

# PC-9801-86 sound: the vendored YM2608 (OPNA) and this core's glue. The
# vendored sources keep their own licences; see src/opna/LICENSE-SCOPE.md.
set_global_assignment -name QIP_FILE src/opna/opna.qip

# PC-9801-86 sound: the 86-PCM block, the card's other device (our own RTL).
set_global_assignment -name SYSTEMVERILOG_FILE src/pcm86/pc9821_pcm86.sv
set_global_assignment -name SYSTEMVERILOG_FILE src/pcm86/pc9821_pcm86_buf.sv

